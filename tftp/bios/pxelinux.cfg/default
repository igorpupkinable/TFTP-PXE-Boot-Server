DEFAULT chainlocal
MENU TITLE BIOS x64 PXE | https://github.com/paulmaunders/TFTP-PXE-Boot-Server
TIMEOUT 150
UI menu.c32

LABEL local
  MENU LABEL Boot local hard drive
  LOCALBOOT 0
  TEXT HELP
  Boot local OS if available. Boot order decided in BIOS.
  ENDTEXT

LABEL chainlocal
  MENU LABEL Chain boot to local hard drive
  COM32 chain.c32
  APPEND hd0
  TEXT HELP
  Boot local OS from first hard disk if available.
  ENDTEXT

LABEL CloneZilla Live 64-bit
  LINUX http://192.168.0.123/images/CloneZilla/20260705-resolute-amd64/vmlinuz
  APPEND initrd=http://192.168.0.123/images/CloneZilla/20260705-resolute-amd64/initrd.img boot=live components config edd=on enforcing=0 keyboard-layouts= locales= net.ifnames=0 nodmraid noeject nomodeset noprompt nosplash noswap ocs_live_batch=no ocs_live_extra_param="" ocs_live_run="ocs-live-general" quiet vga=normal username=user union=overlay fetch=http://192.168.0.123/images/CloneZilla/20260705-resolute-amd64/filesystem.squashfs
  TEXT HELP
  CloneZilla Live 64-bit with safe graphic settings and disabled console
  frame buffer support.
  ENDTEXT

LABEL GParted Live 64-bit
  LINUX http://192.168.0.123/images/GParted/1.5.0-1-amd64/vmlinuz
  APPEND initrd=http://192.168.0.123/images/GParted/1.5.0-1-amd64/initrd.img boot=live config components net.ifnames=0 noeject nomodeset nosplash noswap quiet union=overlay username=user vga=normal fetch=http://192.168.0.123/images/GParted/1.5.0-1-amd64/filesystem.squashfs
  TEXT HELP
  GParted Live 64-bit with safe graphic settings and disabled console
  frame buffer support.
  ENDTEXT

LABEL Ubuntu-16.04-Xenial
  MENU LABEL Install Ubuntu 16.04 (Xenial)
  LINUX images/ubuntu/xenial/amd64/linux
  APPEND initrd=images/ubuntu/xenial/amd64/initrd.gz vga=normal ramdisk_size=16432
